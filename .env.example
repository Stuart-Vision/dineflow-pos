# ---------------------------------------------------------------------------
# DineFlow POS — environment template
# Copy to `.env.local` (Next.js) or `.env` (docker compose) and fill in.
# NEVER commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local single-node replica set started by `npm run db:up`.
# Transactions require a replica set, hence `?replicaSet=rs0`.
MONGODB_URI="mongodb://127.0.0.1:27018/dineflow?replicaSet=rs0&directConnection=true"
# Host port the compose MongoDB publishes on. Change if 27018 is taken.
MONGO_HOST_PORT="27018"
# MongoDB Atlas example:
# MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dineflow?retryWrites=true&w=majority"

# --- Authentication --------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-me-with-a-64-byte-random-hex-string"
# Access token lifetime (seconds). Refresh/session cookie lifetime.
AUTH_SESSION_TTL="43200"          # 12 hours
AUTH_REMEMBER_ME_TTL="2592000"    # 30 days
# bcrypt work factor. 12 is a good production default.
AUTH_BCRYPT_ROUNDS="12"
# Failed-login lockout policy
AUTH_MAX_LOGIN_ATTEMPTS="5"
AUTH_LOCKOUT_MINUTES="15"

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_NAME="DineFlow POS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Set to "false" in a public deployment to hide the demo credential card
# on the login page.
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS="true"

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="120"
RATE_LIMIT_AUTH_MAX_REQUESTS="10"

# --- Payments (abstraction only — no live gateway is wired up) -------------
# Supported drivers: "demo" (in-process, default) | "stripe"
PAYMENT_DRIVER="demo"
# Only read when PAYMENT_DRIVER="stripe". Use TEST keys only.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Outbound messaging (simulated — writes to the notification log) -------
# Drivers: "log" (default, no network) | "smtp"
MAIL_DRIVER="log"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="no-reply@dineflow.example"

SMS_DRIVER="log"

# --- Seeding ---------------------------------------------------------------
# Password applied to every generated demo account.
SEED_DEMO_PASSWORD_SUFFIX="@123"
